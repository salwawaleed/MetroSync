{
  "info": {
    "name": "MetroSync API",
    "_postman_id": "f3f7f1b8-4b2c-4d5b-9d2d-5f2b7c1a2026",
    "description": "MetroSync final-project collection: login, stations, announcements, and protected announcement creation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "stationId",
      "value": "REPLACE_WITH_STATION_ID"
    },
    {
      "key": "token",
      "value": "REPLACE_WITH_JWT"
    },
    {
      "key": "adminEmail",
      "value": "admin@metro.local"
    },
    {
      "key": "adminPassword",
      "value": "ChangeThisBeforeRunning"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health"
            }
          },
          "status": "OK",
          "code": 200,
          "body": "{\n  \"status\": \"ok\"\n}"
        }
      ]
    },
    {
      "name": "Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "response": [
        {
          "name": "200 Token",
          "originalRequest": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login"
            }
          },
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"token\": \"<JWT>\"\n}"
        }
      ]
    },
    {
      "name": "List Stations",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stations"
          ]
        }
      },
      "response": [
        {
          "name": "200 Stations",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stations"
            }
          },
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"data\": [\n    {\n      \"_id\": \"<ObjectId>\",\n      \"name\": \"Central Station\",\n      \"line\": \"Blue Line\",\n      \"order\": 1\n    }\n  ]\n}"
        }
      ]
    },
    {
      "name": "List Announcements",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements?page=1&limit=10&search=service",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stations",
            "{{stationId}}",
            "announcements"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "search",
              "value": "service"
            }
          ]
        }
      },
      "response": [
        {
          "name": "200 Announcements",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements"
            }
          },
          "status": "OK",
          "code": 200,
          "body": "{\n  \"success\": true,\n  \"data\": [],\n  \"pagination\": {\n    \"total\": 0,\n    \"page\": 1,\n    \"limit\": 10,\n    \"pages\": 0\n  }\n}"
        }
      ]
    },
    {
      "name": "Create Announcement",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Service update at Central Station.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "stations",
            "{{stationId}}",
            "announcements"
          ]
        }
      },
      "response": [
        {
          "name": "201 Created",
          "originalRequest": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stations/{{stationId}}/announcements"
            }
          },
          "status": "Created",
          "code": 201,
          "body": "{\n  \"success\": true,\n  \"data\": {\n    \"_id\": \"<ObjectId>\",\n    \"text\": \"Service update at Central Station.\",\n    \"stationId\": \"<ObjectId>\",\n    \"createdAt\": \"<ISO timestamp>\",\n    \"updatedAt\": \"<ISO timestamp>\"\n  }\n}"
        }
      ]
    }
  ]
}